# Copie para .env.local (nunca versionar) e configure também na Vercel.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# URL pública do app (usada nos links de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app

# Fuso das caronas (Brasil sem horário de verão)
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
NEXT_PUBLIC_APP_UTC_OFFSET=-03:00

# Resend (opcional). Sem isso, o aviso de cancelamento por e-mail fica "skipped".
RESEND_API_KEY=
EMAIL_FROM=Caronas <onboarding@resend.dev>

# Somente para testes automatizados (E2E / concorrência). NUNCA usar no front-end.
SUPABASE_SERVICE_ROLE_KEY=

# Somente para aplicar migrations pela CLI (Supabase → Connect → Session pooler). NUNCA versionar.
SUPABASE_DB_URL=
